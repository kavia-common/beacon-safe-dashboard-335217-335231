# Beacon-Safe Backend env (example)
# Do NOT commit real secrets. The orchestrator/runtime will provide these in .env.

# Logging
LOG_LEVEL=INFO

# Frontend origin for CORS (optional; if omitted, backend allows all origins for dev convenience)
VITE_FRONTEND_URL=https://example-frontend.kavia.ai

# Database connection string for the Postgres database container
# Provided by runtime; format example:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
